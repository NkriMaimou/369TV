# Port for local development / hosting platform
PORT=8788

# Set this on production deployments. Required by server.mjs in production
# because the stream proxy can otherwise be abused as a public relay.
PROXY_SECRET=replace-with-a-long-random-secret

# Optional bearer-token authentication for the SDK API.
# If enabled, clients must send Authorization: Bearer <token>.
# Do not put a private token into a public website's VITE_ environment variable.
# API_TOKEN=
