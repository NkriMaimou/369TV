# Local development: the anime API server runs on port 8788.
VITE_ANIME_API_URL=http://localhost:8788

# Production:
# Set VITE_ANIME_API_URL in your frontend hosting provider to the public URL
# of the deployed anime-api service, e.g. https://369tv-anime-api.onrender.com.
# Vite embeds VITE_ variables at build time, so redeploy/rebuild after changing it.
