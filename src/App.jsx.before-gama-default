        .episode-info small { color: #a6a8b6; font-size: .78rem; }
        .episode-info > span { display: -webkit-box; overflow: hidden; color: #c1c2cc; font-size: .82rem; line-height: 1.45; -webkit-box-orient: vertical; -webkit-line-clamp: 2; }
        .player-settings { display: grid; gap: 8px; max-width: 420px; margin-top: 22px; }
        @media (max-width: 900px) {
          .playback-layout { grid-template-columns: minmax(0, 1fr); }
          .episode-list { max-height: 55vh; }
        }
        @media (max-width: 560px) {
          .embedded-player { padding: 10px; border-radius: 14px; }
          .player-frame { border-radius: 9px; }
          .episode-selector { padding: 12px; }
          .episode-selector .episode-fields { grid-template-columns: minmax(0, 1fr); max-width: 280px; }
          .episode-item { gap: 9px; padding: 8px; }
          .episode-still { flex-basis: 88px; width: 88px; height: 58px; }
          .episode-info > span { -webkit-line-clamp: 2; }
        }
      `}</style>
    <header className="topbar">
    <div className="brand">
    <span>369</span> NKRI TV <small></small>
    </div>
    {showPlayer && (
      <button type="button" onClick={backToSearch}>
      Back to search
      </button>
    )}
    </header>

    {!showPlayer && (
      <>
      <section className="hero">
      <p className="eyebrow">YOUR PERSONAL MEDIA HUB</p>
      </section>

      <section className="panel">
      <div className="tabs">
      <button
      className={type === "movie" ? "active" : ""}
      onClick={() => {
        setType("movie");
        setResults([]);
        setSelected(null);
        setError("");
        searchInput.current?.focus();
      }}
      >
      Movies
      </button>

      <button
      className={type === "tv" ? "active" : ""}
      onClick={() => {
        setType("tv");
        setResults([]);
        setSelected(null);
        setError("");
        searchInput.current?.focus();
      }}
      >
      TV Shows
      </button>
      </div>

      <div className="search-wrap">
      <form className="searchrow" onSubmit={search}>
      <input
      ref={searchInput}
      value={query}
      aria-controls="title-search-dropdown"
      aria-expanded={results.length > 0 || (query.trim().length >= 2 && loading)}
      onChange={(e) => setQuery(e.target.value)}
      placeholder={
        type === "movie"
        ? "Search movie titles..."
        : "Search TV show titles..."
      }
      aria-label="Search title"
      />

      <button className="primary" disabled={loading}>
      {loading ? "Searching..." : "Search"}
      </button>
      </form>

      {(results.length > 0 || (query.trim().length >= 2 && (loading || !error))) && (
        <section id="title-search-dropdown" className="search-dropdown" aria-label="Search results">
          <div className="search-dropdown-heading">
            <strong>Search results</strong>
            <span>{loading ? "Searching…" : `${results.length} titles · use arrow keys to navigate`}</span>
          </div>
          {results.length === 0 ? (
            <div className="search-empty">{loading ? "Finding matches…" : "No matching titles found."}</div>
          ) : <div className="results-list">
            {results.map((item, index) => {
              const name = item.title || item.name || "Untitled";
              const year = (item.release_date || item.first_air_date || "").slice(0, 4);
              const image = item.poster_path ? "https://image.tmdb.org/t/p/w185" + item.poster_path : "";
              const favorite = isFavorite(item, type);
              return (
                <div className="dropdown-result-row" key={item.id} style={{ display: "flex", gap: 6, alignItems: "stretch" }}>
                  <button
                    type="button"
                    className="result"
                    data-search-result-index={index}
                    onFocus={() => setFocusedResultIndex(index)}
                    onClick={() => choose(item, type)}
                  >
                    {image ? <img src={image} alt="" /> : <div className="result-poster">NO POSTER</div>}
                    <span className="result-info">
                      <strong>{name}</strong>
                      <small>{year || "Year unknown"} · TMDB {item.id}</small>
                      <small>Rating: {Number(item.vote_average || 0).toFixed(1)} / 10</small>
                      <span className="result-overview">{item.overview || "No description available."}</span>
                    </span>
                  </button>
                  <button type="button" className={`favorite-toggle${favorite ? " active" : ""}`} aria-label={favorite ? `Remove ${name} from favorites` : `Add ${name} to favorites`} title={favorite ? "Remove favorite" : "Add to favorites"} onClick={() => toggleFavorite(item, type)}>{favorite ? "★" : "☆"}</button>
                </div>
              );
            })}
          </div>}
        </section>
      )}
      </div>

      {[
        { title: "Now Playing", items: nowPlayingMovies, mediaType: "movie" },
        { title: "Trending Movies", items: trendingMovies, mediaType: "movie" },
        { title: "Trending TV Shows", items: trendingTvShows, mediaType: "tv" },
      ].map((shelf) => (
        <section className="discovery-section" key={shelf.title} aria-label={shelf.title}>
          <div className="discovery-heading"><h2>{shelf.title}</h2><span className="muted">{shelf.items.length ? `${shelf.items.length} titles` : "Discover"}</span></div>
          {shelf.items.length ? (
            <div className="discovery-track">
              {shelf.items.map((item) => {
                const itemName = item.title || item.name || "Untitled";
                const itemYear = (item.release_date || item.first_air_date || "").slice(0, 4);
                const poster = item.poster_path ? `https://image.tmdb.org/t/p/w342${item.poster_path}` : "";
                const favorite = isFavorite(item, shelf.mediaType);
                return (
                  <article className="discovery-card" key={`${shelf.title}-${item.id}`}>
                    <button type="button" className={`discovery-favorite${favorite ? " active" : ""}`} aria-label={favorite ? `Remove ${itemName} from favorites` : `Add ${itemName} to favorites`} title={favorite ? "Remove favorite" : "Add to favorites"} onClick={() => toggleFavorite(item, shelf.mediaType)}>{favorite ? "★" : "☆"}</button>
                    <button type="button" className="discovery-poster-button" onClick={() => choose(item, shelf.mediaType)}>
                      {poster ? <img className="discovery-poster" src={poster} alt={`Poster for ${itemName}`} loading="lazy" /> : <div className="discovery-poster discovery-no-poster">NO POSTER</div>}
                      <span className="discovery-card-info"><strong>{itemName}</strong><small>{itemYear || "Year unknown"} · ★ {Number(item.vote_average || 0).toFixed(1)}</small></span>
                    </button>
                  </article>
                );
              })}
            </div>
          ) : featuredLoading ? <div className="discovery-loading">Loading titles…</div> : <div className="discovery-loading">Titles are unavailable right now.</div>}
        </section>
      ))}

      <section className="history-section" aria-label={type === "movie" ? "Movie history" : "TV show history"}>
        <div className="history-heading">
          <h2>{type === "movie" ? "Recently watched movies" : "Last played TV shows"}</h2>
          <small className="muted">{history[type].length} saved</small>
        </div>
        {history[type].length > 0 ? (
          <div className="history-grid">
            {history[type].map((item) => {
              const itemName = item.title || item.name || "Untitled";
              const itemDate = (item.release_date || item.first_air_date || "").slice(0, 4);
              const poster = item.poster_path
                ? `https://image.tmdb.org/t/p/w342${item.poster_path}`
                : "";
              return (
                <article className="history-card" key={item.id}>
                  <button
                    type="button"
                    className="history-remove"
                    aria-label={`Remove ${itemName} from history`}
                    title="Remove from history"
                    onClick={() => removeFromHistory(type, item.id)}
                  >
                    ×
                  </button>
                  <button type="button" className={`favorite-star${isFavorite(item, type) ? " active" : ""}`} aria-label={isFavorite(item, type) ? `Remove ${itemName} from favorites` : `Add ${itemName} to favorites`} title={isFavorite(item, type) ? "Remove favorite" : "Add to favorites"} onClick={() => toggleFavorite(item, type)}>{isFavorite(item, type) ? "★" : "☆"}</button>
                  <button type="button" className="history-open" onClick={() => choose(item, type)}>
                    {poster ? (
                      <img className="history-poster" src={poster} alt={`Poster for ${itemName}`} loading="lazy" />
                    ) : (
                      <div className="history-poster history-poster-placeholder">NO POSTER</div>
                    )}
                    <span className="history-card-info">
                      <strong>{itemName}</strong>
                      <small>{itemDate || "Year unknown"} · Rating {Number(item.vote_average || 0).toFixed(1)}/10</small>
                    </span>
                  </button>
                </article>
              );
            })}
          </div>
        ) : (
          <div className="history-empty">
            {type === "movie"
              ? "Movies you open will appear here for quick access."
              : "TV shows you open will appear here for quick access."}
          </div>
        )}
      </section>

      {error && <p className="error">{error}</p>}

      <section className="favorites-section" aria-label="Favorites">
        <div className="history-heading">
          <h2>Favorites</h2>
          <small className="muted">{favorites.length} saved</small>
        </div>
        {favorites.length ? (
          <div className="favorite-grid">
            {favorites.map((item) => {
              const itemType = item._mediaType === "tv" ? "tv" : "movie";
              const itemName = item.title || item.name || "Untitled";
              const itemDate = (item.release_date || item.first_air_date || "").slice(0, 4);
              const poster = item.poster_path ? `https://image.tmdb.org/t/p/w342${item.poster_path}` : "";
              return (
                <article className="favorite-card" key={`${itemType}-${item.id}`}>
                  <button type="button" className="favorite-remove" aria-label={`Remove ${itemName} from favorites`} title="Remove favorite" onClick={() => removeFavorite(item.id, itemType)}>×</button>
                  <button type="button" className="favorite-open" onClick={() => choose(item, itemType)}>
                    {poster ? <img className="history-poster" src={poster} alt={`Poster for ${itemName}`} loading="lazy" /> : <div className="history-poster history-poster-placeholder">NO POSTER</div>}
                    <span className="favorite-info">
                      <strong>{itemName}</strong>
                      <small>{itemType === "movie" ? "Movie" : "TV show"} · {itemDate || "Year unknown"} · {Number(item.vote_average || 0).toFixed(1)}/10</small>
                    </span>
                  </button>
                </article>
              );
            })}
          </div>
        ) : (
          <div className="history-empty">Use the ☆ button on a title to save it here.</div>
        )}
      </section>
      </section>
      </>
    )}

    {showPlayer && selected && (
      <section className="details player-page">
      <div className="metadata">
      {/* Video and TV episodes sit side by side on wider screens. */}
      <div className="playback-layout">
      <div className="playback-main">
      <div className="embedded-player">
      <div className="embedded-player-heading">
      <strong>{title}</strong>
      </div>

      <div className="player-frame">
      <iframe
      key={playerUrl}
      src={playerUrl}
      title={`VidNest player: ${title}`}
      allow="autoplay; fullscreen; picture-in-picture; encrypted-media; remote-playback"
      allowFullScreen
      />
      </div>

      </div>

      <div className="player-settings">
      <label htmlFor="server">VidNest server</label>

      <select
      id="server"
      value={server}
      onChange={(e) => setServer(e.target.value)}
      >
      <option value="auto">Automatic</option>
      <option value="lamda">Lamda</option>
      <option value="primesrc">PrimeSRC</option>
      <option value="sigma">Sigma</option>
      <option value="alfa">Alfa</option>
      <option value="beta">Beta</option>
      <option value="gama">Gama</option>
      <option value="catflix">Catflix</option>
      <option value="hexa">Hexa</option>
      <option value="delta">Delta</option>
      </select>
      </div>
      </div>

      {/* Only TV shows display season and episode selectors. */}
      {type === "tv" && (
        <section className="episode-selector">
        <h3>Episodes <span className="muted" style={{ fontSize: "0.8rem", fontWeight: 500 }}>{episodesLoading ? "Loading…" : episodes.length ? `${episodes.length} episodes` : "Choose a season"}</span></h3>

        <div className="episode-fields">
        <div>
        <label htmlFor="season">Season</label>

        <select
        id="season"
        value={season}
        onChange={(e) => {
          setSeason(e.target.value);
        }}
        >
        {seasons.map((item) => (
          <option
          key={item.season_number}
          value={String(item.season_number)}
          >
          {item.name ||
            `Season ${item.season_number}`}
            {item.episode_count != null
              ? ` (${item.episode_count} episodes)`
              : ""}
              </option>
        ))}
        </select>
        </div>
        </div>

        <label htmlFor="episode-list">Choose episode</label>

        {episodesLoading && (
          <p className="muted">Loading episodes...</p>
        )}

        {!episodesLoading && episodes.length > 0 && (
          <div
          className="episode-list"
          id="episode-list"
          role="listbox"
          aria-label="Episodes"
          >
          {episodes.map((item) => {
            const active =
            String(item.episode_number) === episode;

            return (
              <button
              type="button"
              role="option"
              aria-selected={active}
              key={item.id || item.episode_number}
              className={
                "episode-item" + (active ? " active" : "")
              }
              onClick={() =>
                setEpisode(String(item.episode_number))
              }
              >
              {item.still_path ? (
                <img
                className="episode-still"
                src={
                  "https://image.tmdb.org/t/p/w185" +
                  item.still_path
                }
                alt=""
                loading="lazy"
                />
              ) : (
                <div className="episode-still episode-no-image">
                E{item.episode_number}
                </div>
              )}

              <span className="episode-info">
              <strong>
              E{String(item.episode_number).padStart(2, "0")}
              {" · "}
              {item.name || "Untitled episode"}
              </strong>

              <small>
              {item.air_date || "Air date unknown"}
              {item.runtime
                ? ` · ${item.runtime} min`
                : ""}
                </small>

                <span>
                {item.overview ||
                  "No episode description available."}
                  </span>
                  </span>
                  </button>
            );
          })}
          </div>
        )}

        {episodes.length > 0 && (
          <p className="muted" aria-live="polite">
          Now selected: Season {season}, Episode {episode}
          </p>
        )}
        </section>
      )}
      </div>

      {error && <p className="error">{error}</p>}
      </div>
      </section>
    )}

    <footer></footer>
    </main>
  );
}

function yearLabel(date) {
  return date ? date.slice(0, 4) : "Release date unknown";
}
