        .favorite-remove { position: absolute; top: 7px; right: 7px; z-index: 1; display: grid; place-items: center; width: 28px; height: 28px; padding: 0; color: #fff; background: rgba(7,8,12,.88); border: 1px solid rgba(255,255,255,.22); border-radius: 50%; font-size: 19px; cursor: pointer; }
