import { useState, useRef, useEffect } from "react";
import "./App.css";

const TOKEN = import.meta.env.VITE_TMDB_READ_TOKEN;
const TMDB = "https://api.themoviedb.org/3";

async function tmdbFetch(path, signal) {
  const response = await fetch(`${TMDB}${path}`, {
    headers: {
      Authorization: `Bearer ${TOKEN}`,
      Accept: "application/json",
    },
    signal,
  });

  if (!response.ok) {
    throw new Error(`TMDB returned HTTP ${response.status}`);
  }

  return response.json();
}

export default function App() {
  const [type, setType] = useState("movie");
  const searchInput = useRef(null);

  const [query, setQuery] = useState("");
  const [results, setResults] = useState([]);
  const [selected, setSelected] = useState(null);

  const [season, setSeason] = useState("1");
  const [episode, setEpisode] = useState("1");
  const [seasons, setSeasons] = useState([]);
  const [episodes, setEpisodes] = useState([]);

  const [server, setServer] = useState("auto");
  const [showPlayer, setShowPlayer] = useState(false);

  const [error, setError] = useState("");
  const [loading, setLoading] = useState(false);
  const [episodesLoading, setEpisodesLoading] = useState(false);
  const [history, setHistory] = useState(() => {
    try {
      const saved = localStorage.getItem("369-nkri-tv-history");
      const parsed = saved ? JSON.parse(saved) : { movie: [], tv: [] };
      return {
        movie: Array.isArray(parsed.movie) ? parsed.movie : [],
        tv: Array.isArray(parsed.tv) ? parsed.tv : [],
      };
    } catch {
      return { movie: [], tv: [] };
    }
  });
  const [favorites, setFavorites] = useState(() => {
    try {
      const saved = localStorage.getItem("369-nkri-tv-favorites");
      const parsed = saved ? JSON.parse(saved) : [];
      return Array.isArray(parsed) ? parsed : [];
    } catch {
      return [];
    }
  });
  const [focusedResultIndex, setFocusedResultIndex] = useState(-1);
  const [nowPlayingMovies, setNowPlayingMovies] = useState([]);
  const [trendingMovies, setTrendingMovies] = useState([]);
  const [trendingTvShows, setTrendingTvShows] = useState([]);
  const [featuredLoading, setFeaturedLoading] = useState(true);

  useEffect(() => {
    try {
      localStorage.setItem("369-nkri-tv-history", JSON.stringify(history));
    } catch {
      // History still works for this session if browser storage is unavailable.
    }
  }, [history]);

  useEffect(() => {
    try {
      localStorage.setItem("369-nkri-tv-favorites", JSON.stringify(favorites));
    } catch {
      // Favorites remain available for this session if browser storage is unavailable.
    }
  }, [favorites]);

  // Load homepage discovery shelves from TMDB.
  useEffect(() => {
    if (!TOKEN) {
      setFeaturedLoading(false);
      return;
    }
    const controller = new AbortController();
    async function loadFeatured() {
      setFeaturedLoading(true);
      const requests = [
        ["nowPlaying", "/movie/now_playing?language=en-US&page=1"],
        ["trendingMovies", "/trending/movie/day?language=en-US"],
        ["trendingTv", "/trending/tv/day?language=en-US"],
      ];
      try {
        const responses = await Promise.all(requests.map(async ([key, path]) => {
          try {
            const data = await tmdbFetch(path, controller.signal);
            return [key, data.results || []];
          } catch (error) {
            if (error.name === "AbortError") throw error;
            return [key, []];
          }
        }));
        if (controller.signal.aborted) return;
        for (const [key, items] of responses) {
          if (key === "nowPlaying") setNowPlayingMovies(items);
          if (key === "trendingMovies") setTrendingMovies(items);
          if (key === "trendingTv") setTrendingTvShows(items);
        }
      } catch (error) {
        // Keep the rest of the home screen usable if discovery data is unavailable.
      } finally {
        if (!controller.signal.aborted) setFeaturedLoading(false);
      }
    }
    loadFeatured();
    return () => controller.abort();
  }, []);

  function isFavorite(item, itemType = type) {
    return favorites.some(
      (favorite) => favorite.id === item.id && favorite._mediaType === itemType
    );
  }

  function toggleFavorite(item, itemType = type) {
    setFavorites((current) => {
      const exists = current.some(
        (favorite) => favorite.id === item.id && favorite._mediaType === itemType
      );
      if (exists) {
        return current.filter(
          (favorite) => !(favorite.id === item.id && favorite._mediaType === itemType)
        );
      }
      return [{ ...item, _mediaType: itemType }, ...current].slice(0, 100);
    });
  }

  function removeFavorite(id, itemType) {
    setFavorites((current) => current.filter(
      (item) => !(item.id === id && item._mediaType === itemType)
    ));
  }

  function removeFromHistory(historyType, id) {
    setHistory((current) => ({
      ...current,
      [historyType]: current[historyType].filter((item) => item.id !== id),
    }));
  }

  async function search(event) {
    event?.preventDefault();

    if (!TOKEN) {
      setError("TMDB token missing. Check .env.local and restart Vite.");
      return;
    }

    if (!query.trim()) {
      setError("Enter a movie or TV show name.");
      return;
    }

    setLoading(true);
    setError("");
    setSelected(null);
    setShowPlayer(false);
    setResults([]);
    setSeasons([]);
    setEpisodes([]);

    try {
      const endpoint = type === "movie" ? "movie" : "tv";
      const data = await tmdbFetch(
        `/search/${endpoint}?query=${encodeURIComponent(
          query.trim()
        )}&include_adult=false&language=en-US&page=1`
      );

      setResults(data.results || []);
      setFocusedResultIndex(-1);

      if (!data.results?.length) {
        setError("No matching titles found.");
      }
    } catch (e) {
      if (e.name !== "AbortError") {
        setError(e.message || "Search failed.");
      }
    } finally {
      setLoading(false);
    }
  }

  // Debounced live search: update the dropdown as the user types.
  useEffect(() => {
    const trimmed = query.trim();
    if (showPlayer) return;
    if (trimmed.length < 2) {
      setResults([]);
      setFocusedResultIndex(-1);
      setLoading(false);
      setError("");
      return;
    }
    if (!TOKEN) {
      setError("TMDB token missing. Check .env.local and restart Vite.");
      return;
    }

    // Clear stale feedback immediately, then wait briefly before querying TMDB.
    setError("");
    const controller = new AbortController();
    const timeout = setTimeout(async () => {
      setLoading(true);
      try {
        const endpoint = type === "movie" ? "movie" : "tv";
        const data = await tmdbFetch(
          `/search/${endpoint}?query=${encodeURIComponent(trimmed)}&include_adult=false&language=en-US&page=1`,
          controller.signal
        );
        if (!controller.signal.aborted) {
          setResults(data.results || []);
          setFocusedResultIndex(-1);
        }
      } catch (e) {
        if (e.name !== "AbortError" && !controller.signal.aborted) {
          setError(e.message || "Search failed.");
          setResults([]);
        }
      } finally {
        if (!controller.signal.aborted) setLoading(false);
      }
    }, 300);

    return () => {
      clearTimeout(timeout);
      controller.abort();
    };
  }, [query, type, showPlayer]);


  const title = selected?.title || selected?.name || "";
  const date = selected?.release_date || selected?.first_air_date || "";

  const playerUrl = selected
  ? "https://vidnest.fun/" +
  (type === "movie"
  ? `movie/${selected.id}`
  : `tv/${selected.id}/${season}/${episode}`) +
  (server !== "auto"
  ? `?server=${encodeURIComponent(server)}`
  : "")
  : "";

  function choose(item, itemType = type) {
    setType(itemType);
    setSelected(item);
    setHistory((current) => {
      const currentList = current[itemType].filter((entry) => entry.id !== item.id);
      return {
        ...current,
        [itemType]: [item, ...currentList].slice(0, 12),
      };
    });
    setResults([]);
    setFocusedResultIndex(-1);
    setShowPlayer(true);
    setError("");
    setSeason("1");
    setEpisode("1");
    setSeasons([]);
    setEpisodes([]);
  }

  function backToSearch() {
    setShowPlayer(false);
    setSelected(null);
    setSeasons([]);
    setEpisodes([]);
    setError("");
    // Wait for the search screen to render again before focusing its input.
    requestAnimationFrame(() => searchInput.current?.focus());
  }

  // Backspace and Escape return from the player screen to search.
  useEffect(() => {
    if (!showPlayer) return;

    function handlePlayerBack(event) {
      if (event.key !== "Backspace" && event.key !== "Escape") return;
      event.preventDefault();
      backToSearch();
    }

    document.addEventListener("keydown", handlePlayerBack);
    return () => document.removeEventListener("keydown", handlePlayerBack);
  }, [showPlayer]);

  // Global keyboard navigation. Arrow keys move through visible controls/cards on both pages.
  useEffect(() => {
    function handleArrowNavigation(event) {
      if (!["ArrowUp", "ArrowDown", "ArrowLeft", "ArrowRight"].includes(event.key)) return;
      const target = event.target;
      const tag = target?.tagName?.toLowerCase();
      if (tag === "select" || tag === "textarea" || target?.isContentEditable) return;

      // In the search box, ArrowDown opens keyboard navigation into the results dropdown.
      if (target === searchInput.current && event.key === "ArrowDown" && results.length) {
        event.preventDefault();
        setFocusedResultIndex((current) => {
          const next = current < results.length - 1 ? current + 1 : 0;
          requestAnimationFrame(() => {
            document.querySelector(`[data-search-result-index="${next}"]`)?.focus();
          });
          return next;
        });
        return;
      }

      // Leave arrow keys to normal text editing while typing in non-search inputs.
      if (tag === "input" && target !== searchInput.current) return;

      const controls = Array.from(document.querySelectorAll(
        ".app button:not(:disabled), .app input:not(:disabled), .app select:not(:disabled), .app a[href], .app [tabindex]:not([tabindex='-1'])"
      )).filter((element) => {
        if (element.closest("[hidden]")) return false;
        const style = window.getComputedStyle(element);
        return style.display !== "none" && style.visibility !== "hidden" && element.getClientRects().length > 0;
      });
      if (!controls.length) return;
      const currentIndex = controls.indexOf(document.activeElement);
      const forward = event.key === "ArrowDown" || event.key === "ArrowRight";
      let nextIndex;
      if (currentIndex < 0) nextIndex = 0;
      else nextIndex = (currentIndex + (forward ? 1 : -1) + controls.length) % controls.length;
      event.preventDefault();
      controls[nextIndex]?.focus();
    }
    document.addEventListener("keydown", handleArrowNavigation);
    return () => document.removeEventListener("keydown", handleArrowNavigation);
  }, [results]);

  // Fetch the actual season list for the selected TV show.
  useEffect(() => {
    if (!selected || type !== "tv" || !TOKEN) return;

    const controller = new AbortController();

    async function loadSeasons() {
      try {
        const data = await tmdbFetch(
          `/tv/${selected.id}?language=en-US`,
          controller.signal
        );

        setSeasons(
          (data.seasons || []).filter(
            (item) => item.season_number >= 0
          )
        );
      } catch (e) {
        if (e.name !== "AbortError") {
          setError("Could not load seasons: " + e.message);
        }
      }
    }

    loadSeasons();

    return () => controller.abort();
  }, [selected, type]);

  // Fetch the actual episodes for the chosen season.
  useEffect(() => {
    if (!selected || type !== "tv" || !TOKEN || season === "") {
      setEpisodes([]);
      return;
    }

    const controller = new AbortController();

    async function loadEpisodes() {
      setEpisodesLoading(true);
      setEpisodes([]);
      setError("");

      try {
        const data = await tmdbFetch(
          `/tv/${selected.id}/season/${encodeURIComponent(
            season
          )}?language=en-US`,
          controller.signal
        );

        const list = data.episodes || [];
        setEpisodes(list);

        if (list.length) {
          setEpisode(String(list[0].episode_number));
        } else {
          setError("No episodes are listed for this season.");
        }
      } catch (e) {
        if (e.name !== "AbortError") {
          setError("Could not load episodes: " + e.message);
        }
      } finally {
        if (!controller.signal.aborted) {
          setEpisodesLoading(false);
        }
      }
    }

    loadEpisodes();

    return () => controller.abort();
  }, [selected, type, season]);

