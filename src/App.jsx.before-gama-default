        .search-dropdown-heading { display: flex; justify-content: space-between; align-items: center; gap: 12px; padding: 5px 7px 10px; color: #a6a8b6; font-size: .8rem; }
        .search-dropdown .results-list { display: grid; gap: 6px; }
        .discovery-section { margin-top: 30px; }
