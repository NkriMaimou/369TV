        .favorite-info small { color: #a6a8b6; font-size: .76rem; }
        .favorite-star { position: absolute; top: 7px; left: 7px; z-index: 1; display: grid; place-items: center; width: 29px; height: 29px; padding: 0; color: #fff; background: rgba(7,8,12,.88); border: 1px solid rgba(255,255,255,.22); border-radius: 50%; font-size: 17px; cursor: pointer; }
