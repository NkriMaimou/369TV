import React, { useCallback, useEffect, useRef, useState } from "react";
import { browseAnime, searchAnime } from "./animeApi.js";

const PAGE_SIZE = 20;
const NEXT_PAGE_SIZE = 10;
const SECTIONS = [
  { id: "trending", label: "Trending Now" },
{ id: "popular", label: "Popular Anime" },
{ id: "top", label: "Top Rated" },
{ id: "seasonal", label: "This Season" },
];

const GENRES = [
  "All", "Action", "Adventure", "Comedy", "Drama",
"Fantasy", "Horror", "Mystery", "Romance", "Sci-Fi", "Slice of Life",
];

function titleOf(item) {
  const title = item?.title;
  if (typeof title === "string") return title;
  return title?.english || title?.userPreferred || title?.romaji || "Unknown Anime";
}

function posterOf(item) {
  return item?.cover?.large ||
  item?.cover?.medium ||
  item?.coverImage?.extraLarge ||
  item?.coverImage?.large ||
  item?.poster ||
  item?.image ||
  "";
}

function yearOf(item) {
  return item?.year || item?.seasonYear || item?.startDate?.year || "";
}

function scoreOf(item) {
  const value = Number(item?.score);
  if (!Number.isFinite(value) || item?.score == null || item?.score === "") return "";
  return value > 10 ? (value / 10).toFixed(1) : value.toFixed(1);
}

function normalizeGenre(value) {
  return String(value ?? "")
    .normalize("NFKC")
    .trim()
    .toLowerCase()
    .replace(/&/g, "and")
    .replace(/[^a-z0-9]+/g, " ")
    .trim();
}

function genresOf(item) {
  const value = item?.genres ?? item?.genre ?? [];
  const genres = Array.isArray(value) ? value : [value];

  return [...new Set(
    genres
      .map((genre) => {
        if (typeof genre === "string") return genre.trim();
        if (typeof genre === "object" && genre !== null) {
          return String(genre.name ?? genre.label ?? "").trim();
        }
        return "";
      })
      .filter(Boolean)
  )];
}

function listOf(payload) {
  if (Array.isArray(payload)) return payload;
  return payload?.results || payload?.items || payload?.media || payload?.data || [];
}

function itemKey(item) {
  return String(item?.id ?? item?.mediaId ?? item?.malId ??
  item?.title?.english ?? item?.title?.romaji ?? titleOf(item));
}

function mergeUnique(existing, incoming) {
  const seen = new Set(existing.map(itemKey));
  return [...existing, ...incoming.filter((item) => {
    const key = itemKey(item);
    if (seen.has(key)) return false;
    seen.add(key);
    return true;
  })];
}

export default function AnimeDiscovery({ provider, onChoose }) {
  const [catalogues, setCatalogues] = useState({});
  const [activeGenre, setActiveGenre] = useState("All");
  const [season, setSeason] = useState("FALL");
  const [seasonYear, setSeasonYear] = useState(new Date().getFullYear());
  const [loading, setLoading] = useState(true);
  const [loadingMore, setLoadingMore] = useState({});
  const [opening, setOpening] = useState("");
  const [error, setError] = useState("");
  const inFlightRef = useRef(new Set());
  const exhaustedRef = useRef(new Set());
  const pagesRef = useRef({});
  const generationRef = useRef(0);

  useEffect(() => {
    let cancelled = false;
    generationRef.current += 1;
    inFlightRef.current.clear();
    exhaustedRef.current.clear();
    pagesRef.current = {};
    setLoading(true);
    setLoadingMore({});
    setError("");
    setCatalogues({});

    async function loadCatalogues() {
      const requests = await Promise.allSettled(
        SECTIONS.map((section) => browseAnime(section.id, {
          perPage: PAGE_SIZE,
          page: 1,
          ...(section.id === "seasonal" ? { season, year: seasonYear } : {}),
        }))
      );

      if (cancelled) return;

      const next = {};
      requests.forEach((result, index) => {
        const key = SECTIONS[index].id;
        const items = result.status === "fulfilled" ? listOf(result.value) : [];
        next[key] = items;
        pagesRef.current[key] = 2;
        if (items.length < PAGE_SIZE) exhaustedRef.current.add(key);
        if (result.status === "rejected") {
          console.warn(`Anime catalogue "${key}" failed:`, result.reason);
        }
      });

      setCatalogues(next);
      if (!Object.values(next).some((items) => items.length)) {
        setError("Anime catalogues could not be loaded. Check that your Anime API is reachable.");
      }
      setLoading(false);
    }

    loadCatalogues();
    return () => { cancelled = true; };
  }, [season, seasonYear]);

  const loadNextPage = useCallback(async (sectionId) => {
    if (loading || inFlightRef.current.has(sectionId) || exhaustedRef.current.has(sectionId)) return;
    const generation = generationRef.current;
    inFlightRef.current.add(sectionId);
    setLoadingMore((current) => ({ ...current, [sectionId]: true }));
    const nextPage = pagesRef.current[sectionId] || 3;
    const section = SECTIONS.find((entry) => entry.id === sectionId);

    try {
      const payload = await browseAnime(sectionId, {
        perPage: NEXT_PAGE_SIZE,
        page: nextPage,
        ...(sectionId === "seasonal" ? { season, year: seasonYear } : {}),
      });
      if (generation !== generationRef.current) return;
      const items = listOf(payload);
      setCatalogues((current) => ({
        ...current,
        [sectionId]: mergeUnique(current[sectionId] || [], items),
      }));
      pagesRef.current[sectionId] = nextPage + 1;
      if (items.length < NEXT_PAGE_SIZE) exhaustedRef.current.add(sectionId);
    } catch (err) {
      console.warn(`Could not load more anime for "${section?.label || sectionId}":`, err);
      // Do not mark the shelf exhausted; a later scroll can retry the failed page.
    } finally {
      if (generation === generationRef.current) {
        inFlightRef.current.delete(sectionId);
        setLoadingMore((current) => ({ ...current, [sectionId]: false }));
      }
    }
  }, [loading, season, seasonYear]);

  async function openAnime(item) {
    const title = titleOf(item);
    setOpening(title);
    setError("");

    try {
      const results = listOf(await searchAnime(title, provider));
      if (!results.length) {
        setError(`"${title}" was not found on the selected streaming source. Try another source or search manually.`);
        return;
      }

      const normalize = (value) => String(value || "")
      .toLowerCase()
      .replace(/[^a-z0-9]/g, "");

      const match = results.find((result) =>
      normalize(result?.title?.english || result?.title?.romaji || result?.title || result?.name) === normalize(title)
      ) || results[0];

      await onChoose(match);
    } catch (err) {
      setError(err?.message || `Could not find "${title}" on the selected source.`);
    } finally {
      setOpening("");
    }
  }

  const allItems = Object.values(catalogues).flat();

  const genreCounts = new Map();

  for (const item of allItems) {
    for (const genre of genresOf(item)) {
      const key = normalizeGenre(genre);
      if (!key) continue;

      const existing = genreCounts.get(key);

      if (existing) {
        existing.count += 1;
      } else {
        genreCounts.set(key, { name: genre, count: 1 });
      }
    }
  }

  const hasGenreData = genreCounts.size > 0;

  const genreOptions = [
    "All",
    ...GENRES.filter((genre) => genre !== "All")
      .filter((genre) => genreCounts.has(normalizeGenre(genre))),
    ...[...genreCounts.entries()]
      .filter(([key]) =>
        !GENRES.some((genre) =>
          genre !== "All" && normalizeGenre(genre) === key
        )
      )
      .map(([, value]) => value.name)
      .sort((a, b) => a.localeCompare(b)),
  ];

  return (
    </div>
    <div className="anime-season-select">
    <label>
    Season
    <select value={season} onChange={(event) => setSeason(event.target.value)}>
    <option value="WINTER">Winter</option>
    <option value="SPRING">Spring</option>
    <option value="SUMMER">Summer</option>
    <option value="FALL">Fall</option>
    </select>
    </label>
    <label>
    Year
    <select value={seasonYear} onChange={(event) => setSeasonYear(Number(event.target.value))}>
    {Array.from({ length: 8 }, (_, index) => new Date().getFullYear() - index).map((year) => (
      <option value={year} key={year}>{year}</option>
    ))}
    </select>
    </label>
    </div>
    </div>

    <nav className="anime-genre-tabs" aria-label="Anime genres">
      {genreOptions.map((genre) => {
        const isAll = genre === "All";
        const count = isAll
          ? allItems.length
          : genreCounts.get(normalizeGenre(genre))?.count ?? 0;

        return (
          <button
            type="button"
            key={genre}
            className={activeGenre === genre ? "active" : ""}
            aria-pressed={activeGenre === genre}
            disabled={!isAll && count === 0}
            onClick={() => setActiveGenre(genre)}
          >
            {genre}
            {!isAll && (
              <span className="anime-genre-count"> {count}</span>
            )}
          </button>
        );
      })}
    </nav>

    {loading && <p className="anime-discovery-status">Loading anime catalogues…</p>}
    {error && <p className="anime-hub-message" role="status">{error}</p>}
    {!hasGenreData && !loading && (
      <p className="anime-discovery-note">
      Genre filters require genre data from the metadata API.
      </p>
    )}

    {SECTIONS.map((section) => {
      const items = catalogues[section.id] || [];
      const selectedGenre = normalizeGenre(activeGenre);

      const filtered = selectedGenre === "all"
        ? items
        : items.filter((item) =>
            genresOf(item).some(
              (genre) => normalizeGenre(genre) === selectedGenre
            )
          );

      if (!loading && !filtered.length) return null;

      return (
        <section className="anime-discovery-section" key={section.id}>
        <div className="anime-discovery-section-heading">
        <h3>{section.label}</h3>
        <span>{filtered.length ? `${filtered.length} titles` : loading ? "Loading…" : ""}</span>
        </div>
        <div
        className="anime-discovery-track"
        onScroll={(event) => {
          const track = event.currentTarget;
          if (track.scrollWidth - track.clientWidth - track.scrollLeft < 360) {
            void loadNextPage(section.id);
          }
        }}
onWheel={(event) => {
          const track = event.currentTarget;
          if (track.scrollWidth <= track.clientWidth) return;

          // Without Shift, block horizontal wheel/trackpad gestures but
          // leave vertical page scrolling alone.
          if (!event.shiftKey) {
            if (Math.abs(event.deltaX) > Math.abs(event.deltaY) && event.deltaX !== 0) {
              event.preventDefault();
            }
            return;
          }

          // Shift works with either the left or right Shift key.
          const delta = Math.abs(event.deltaY) > Math.abs(event.deltaX)
            ? event.deltaY
            : event.deltaX;
          const canMove = delta > 0
            ? track.scrollLeft + track.clientWidth < track.scrollWidth - 1
            : delta < 0 && track.scrollLeft > 0;

          if (delta !== 0 && canMove) {
            track.scrollLeft += delta;
            event.preventDefault();
          }
        }}
        aria-label={`${section.label} anime; horizontally scroll for more`}
        >
        {filtered.map((item, index) => {
          const title = titleOf(item);
          const poster = posterOf(item);
          const score = scoreOf(item);

          return (
            <button
            type="button"
            className="anime-discovery-card"
            key={item.id || `${section.id}-${title}-${index}`}
            onClick={() => openAnime(item)}
            disabled={Boolean(opening)}
            title={`Open ${title}`}
            >
            <span className="anime-discovery-poster">
            {poster
              ? <img src={poster} alt="" loading="lazy" />
              : <span className="anime-discovery-poster-fallback">ANIME</span>}
              {score && <span className="anime-discovery-score">★ {score}</span>}
              <span className="anime-discovery-play" aria-hidden="true">▶</span>
              </span>
              <span className="anime-discovery-card-title">{title}</span>
              <span className="anime-discovery-card-meta">
              {[yearOf(item), item.format].filter(Boolean).join(" · ") || "Anime"}
              </span>
              {opening === title && <span className="anime-discovery-opening">Opening…</span>}
              </button>
          );
        })}
        {(loading || loadingMore[section.id]) && Array.from({ length: 5 }, (_, index) => (
          <div className="anime-discovery-skeleton" key={`skeleton-${index}`} aria-hidden="true">
          <span className="anime-discovery-skeleton-poster" />
          <span className="anime-discovery-skeleton-line" />
          <span className="anime-discovery-skeleton-line short" />
          </div>
        ))}
        </div>
        </section>
      );
    })}
    </div>
  );
}
